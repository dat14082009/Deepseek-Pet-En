{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default permissions for dsh-whale-tauri",
  "local": true,
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/**",
      "http://localhost:*/**"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "allow-set-ignore-mouse",
    "allow-get-fullscreen-mode",
    "allow-set-fullscreen-mode",
    "allow-start-compact-drag",
    "allow-compact-drag",
    "allow-stop-compact-drag"
  ]
}
